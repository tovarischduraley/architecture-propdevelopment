        <mxCell id="lHh-nsBpDkdw4FUw_z_q-211" value="Критический" style="connectable=0;recursiveResize=0;strokeColor=#b85450;fillColor=#f8cecc;align=center;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1" parent="lHh-nsBpDkdw4FUw_z_q-208" vertex="1">
