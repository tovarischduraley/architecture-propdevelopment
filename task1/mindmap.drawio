        </mxCell>
        <mxCell id="lHh-nsBpDkdw4FUw_z_q-172" value="Ошибки в метаданных, несогласованность данных между приложениями ухудшают качество работы систем, приводят к сбоям в автоматизации процессов, ошибочным отчётам." style="connectable=0;recursiveResize=0;strokeColor=#d79b00;fillColor=#ffe6cc;whiteSpace=wrap;html=1;" parent="lHh-nsBpDkdw4FUw_z_q-170" vertex="1">
          <mxGeometry x="150" width="300" height="58" as="geometry">
            <mxRectangle width="300" height="58" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
