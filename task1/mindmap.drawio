        </mxCell>
        <mxCell id="lHh-nsBpDkdw4FUw_z_q-142" value="Неправильно заполненные карточки объектов, дублирование, ошибки в описании создают ощущение некомпетентности, ухудшают пользовательский опыт, мешают продажам." style="connectable=0;recursiveResize=0;strokeColor=#d79b00;fillColor=#ffe6cc;whiteSpace=wrap;html=1;" parent="lHh-nsBpDkdw4FUw_z_q-140" vertex="1">
          <mxGeometry x="150" width="300" height="88" as="geometry">
            <mxRectangle width="300" height="88" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
