        <mxCell id="lHh-nsBpDkdw4FUw_z_q-137" value="&lt;span style=&quot;color: rgba(0, 0, 0, 0.85); font-family: &amp;quot;YS Text&amp;quot;, sans-serif; text-align: left; white-space-collapse: preserve-breaks;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;искажение данных&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;" style="connectable=0;recursiveResize=0;strokeColor=#d79b00;fillColor=#ffe6cc;fontStyle=0;align=center;whiteSpace=wrap;html=1;" parent="lHh-nsBpDkdw4FUw_z_q-136" vertex="1">
